# 멈춘 다음 백엔드 설정 예시. 실제 값은 .env 또는 환경변수로 설정하고 저장소에 올리지 마세요.
# 서버가 바인딩할 주소. 에뮬레이터만 쓰면 127.0.0.1, 실제 휴대폰은 0.0.0.0 (토큰 필수)
HOST=127.0.0.1
PORT=8787
# Bearer 토큰. HOST가 루프백이 아니면 16자 이상 필수. 아래는 예시 자리표시자입니다.
AFTERSTOP_TOKEN=change-me-to-a-long-random-string
# Host 헤더로 허용할 호스트명 (쉼표 구분, 포트는 리슨 포트와 같아야 함). 10.0.2.2 = 에뮬레이터의 PC 별칭
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# 접속을 허용할 클라이언트 IP 또는 IPv4 CIDR (쉼표 구분). 기본은 루프백만
ALLOWED_CLIENTS=127.0.0.1,::1
# 로컬 Ollama 채팅 주소 (루프백만 허용)
OLLAMA_URL=http://127.0.0.1:11434/api/chat
# 설치된 비전 모델 이름. 비어 있으면 /api/analyze 는 503
VISION_MODEL=
# 모델 응답 대기 한도(ms)
MODEL_TIMEOUT_MS=55000
